# Docker Compose
CONTAINER_PREFIX=semantic_search
APP_BIND_IP=127.0.0.1
APP_PORT=8080

# Internal Docker service addresses
REDIS_HOST=redis
REDIS_PORT=6379

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=5
QDRANT_CONNECT_RETRIES=30
QDRANT_RETRY_DELAY=1

# Local embedding model
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
# Leave empty for automatic device selection, or set cpu/cuda explicitly
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=8
DOCUMENTS_COLLECTION_NAME=semantic_documents
MAX_TEXT_LENGTH=4000
MAX_BATCH_SIZE=100
DEFAULT_SEARCH_LIMIT=10

JWT_SECRET_KEY=change-this-secret-in-production
